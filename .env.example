# Copy to .env.local and fill in. Never commit .env.local.
# Supabase values: Dashboard → your `tripnest` project → Settings → API Keys.

# Public site URL (used for metadata and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Safe to expose in the browser — access is limited by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# SERVER ONLY — bypasses Row Level Security. Never prefix with NEXT_PUBLIC_, never paste it anywhere public.
# Not needed until admin tooling in Phase 9; leave empty for now.
SUPABASE_SECRET_KEY=
