# Copy to .env.local and fill in. Never commit .env.local.
# Supabase values: Dashboard → your `tripnest` project → Settings → API Keys.

# Public site URL (used for metadata and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Safe to expose in the browser — access is limited by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Razorpay TEST MODE (optional). Payments are only switched on when BOTH values are set. SERVER ONLY.
# Only `rzp_test_...` keys are accepted; a live key is ignored. See docs/PAYMENTS.md.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SERVER ONLY — bypasses Row Level Security. Never prefix with NEXT_PUBLIC_, never paste it anywhere public.
# Not used by the app at the moment (all access goes through Row Level Security); leave it empty.
SUPABASE_SECRET_KEY=

# Optional: real contact details shown in the footer and on /contact. Leave empty to hide them.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
